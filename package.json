{
  "name": "openarticle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first article reader and legitimate source discovery",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build && playwright test",
    "demo": "node scripts/demo.mjs",
    "test:live": "npm run build && node scripts/test-live.mjs",
    "inspect:access": "npm run build && node scripts/inspect-access.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0"
  }
}
