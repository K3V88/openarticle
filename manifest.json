{
  "manifest_version": 3,
  "name": "OpenArticle",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Read available articles and discover legitimate public versions. No tracking or access-control bypass.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenArticle"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
